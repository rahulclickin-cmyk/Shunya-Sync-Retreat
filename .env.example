# ====================================================================
# SHUNYA SYNC RETREAT - ENVIRONMENT VARIABLES
# Copy these into your Vercel Project Settings -> Environment Variables
# or local .env file
# ====================================================================

# 1. Supabase Project URL (From Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# 2. Supabase Anon Public Key (From Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 3. Supabase Storage Bucket for Client Uploaded Photos (Default: retreat-media)
VITE_SUPABASE_STORAGE_BUCKET="retreat-media"

# 4. Supabase Database Table Name for Live Site Config (Default: shunya_site_config)
VITE_SUPABASE_TABLE_NAME="shunya_site_config"

# 5. Admin Security Passcode for /admin (Default: 7788 or shunya2026)
VITE_ADMIN_PIN="7788"

# 6. Production Domain URL for Canonical SEO & OpenGraph Sharing
VITE_CANONICAL_URL="https://shunyasync.com"
